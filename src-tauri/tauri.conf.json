{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Arkmind",
  "identifier": "com.arkmind.app",
  "version": "14.1.2",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Arkmind",
        "width": 1200,
        "height": 700,
        "minWidth": 1200,
        "minHeight": 700,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: https://asset.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost blob: data:; font-src 'self'; connect-src 'self' https://api.openai.com https://api.siliconflow.cn https://dashscope.aliyuncs.com; media-src 'self'",
    "assetProtocol": {
      "enable": true,
      "scope": ["$APPDATA/com.arkmind.app/**", "$TEMP/arkmind_attach/**", "$TEMP/email_att_*"]
    }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "resources": [],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"]
  }
}
